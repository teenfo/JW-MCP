# jw-mcp 환경변수 템플릿. .env 로 복사해 채우고, .env 는 절대 커밋하지 않는다.
# (deploy/bootstrap.sh 를 쓰면 시크릿이 자동 발급된 .env 가 만들어진다.)

# --- 바인딩 ---
# 반드시 루프백에만 바인딩한다. 공인 노출은 Caddy 가 담당하며, Caddy 가 라우팅하지
# 않는 경로(/api/dash/*)는 그래서 인터넷에서 닿지 않는다.
JW_HOST=127.0.0.1
JW_PORT=8604

# --- 경로 분리 ---
# hosub 와 도메인을 공유하므로 이 프리픽스가 두 서비스를 가르는 경계다.
# OAuth issuer 는 JW_PUBLIC_URL + JW_BASE_PATH 가 된다.
JW_BASE_PATH=/jw

# --- 공개 URL (OAuth 메타데이터용) ---
# 비우면 X-Forwarded-Proto/Host 에서 유추한다. 운영에서는 명시하는 편이 안전하다
# (프록시 헤더가 빠지면 issuer 가 흔들려 커넥터 연결이 깨진다).
# 예: https://hosub.duckdns.org
JW_PUBLIC_URL=

# --- 저장소 ---
# 사용자·OAuth 토큰·사용량이 전부 여기 들어간다. hosub 의 DB 와 공유하지 않는다.
JW_DB=data/jw.db

# --- 시크릿 ---
# 브라우저 세션 쿠키 서명 키. 32자 이상 (openssl rand -hex 32). 비우면 기동 거부.
# 바꾸면 모든 로그인 세션이 무효가 된다(OAuth 토큰은 영향 없음).
JW_SESSION_SECRET=

# 대시보드 내부 API 토큰. hosub-mcp 의 HOSUB_JW_TOKEN 과 **같은 값**이어야 한다.
# 비우면 /api/dash/* 를 아예 마운트하지 않는다(대시보드 연동 비활성).
JW_INTERNAL_TOKEN=

# --- 다중 사용자 정책 ---
# 여기 적힌 이메일로 가입하면 자동으로 관리자·활성 상태가 된다(쉼표 구분).
# 비워도 된다 — 최초 가입자는 어차피 자동으로 관리자가 된다(부트스트랩).
JW_ADMIN_EMAILS=

# 초대 코드. 설정하면 이 코드를 입력한 가입자는 관리자 승인 없이 바로 쓸 수 있다.
# 비우면 초대 기능이 꺼지고, 모든 신규 가입은 관리자 승인을 거친다.
JW_INVITE_CODE=

# --- 개발용 ---
# false 면 세션 쿠키에서 Secure 플래그를 뺀다. 평문 http 로 로컬 테스트할 때만 쓴다.
# 운영에서는 절대 false 로 두지 않는다.
JW_SECURE_COOKIES=true

# --- 자동 배포 ---
# jw-mcp-update.timer 가 5분마다 이 브랜치를 폴링해 새 커밋이 있으면 반영한다.
JW_MCP_BRANCH=main
